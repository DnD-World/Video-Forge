# Every environment variable Video Forge reads. All optional: the app works with none set.
# The app does not load a .env file itself. Set these in the terminal before starting it
# (PowerShell: $env:NAME = "value"; npm run dev). Never put real keys or passwords here.

# Optional. Folder holding the YouTube sign-in files. Default: the SECRETS folder next to
# this repo. (BYOK_SECRETS_DIR is the old name and still works.) electron/net/youtube.ts
VIDEOFORGE_SECRETS_DIR=

# Optional. A separate data folder, to run a test copy without touching your real
# projects and settings. Default: the app's normal data folder. electron/main.ts
VIDEOFORGE_USER_DATA=

# Optional. 1 = render videos on the processor instead of the graphics card (slower, for
# a machine where the graphics card misbehaves). Default: graphics card.
# electron/render/hyperframes/renderHyperframes.ts
VIDEOFORGE_RENDER_CPU=

# Optional. Colour boost for intro and outro cards, 0.5 to 2. Default: 1 (the setting in
# the app wins when set). electron/render/joinCards.ts
VIDEOFORGE_CARD_SATURATION=

# Optional. Full path to a headless browser for rendering, if the app can't find one.
# Default: searched in the usual places. electron/render/hyperframes/renderBrowser.ts
HYPERFRAMES_BROWSER_PATH=
