{
  "name": "video-forge",
  "version": "0.1.0",
  "description": "Video Forge — deterministic desktop video production machine",
  "author": "Stravelakis",
  "license": "MIT",
  "type": "module",
  "main": "./out/main/main.js",
  "scripts": {
    "dev": "electron-vite dev --watch",
    "build": "electron-vite build",
    "preview": "electron-vite preview",
    "start": "electron-vite preview",
    "job": "electron . --job",
    "sfx": "electron . --sfx",
    "sfx:free": "electron . --sfx-free",
    "build-exe": "node scripts/build-exe.mjs",
    "outros": "electron . --add-outros",
    "ask-forge": "node tools/ask-forge.mjs",
    "brand": "node tools/use-brand.mjs",
    "test": "node --test tools/lib/forgeLink.test.mjs tools/lib/brand.test.mjs tools/lib/migrateUserData.test.mjs tools/lib/scriptMatch.test.mjs tools/lib/greekAccents.test.mjs tools/lib/mediaCache.test.mjs",
    "test:link": "node --test tools/lib/forgeLink.test.mjs"
  },
  "dependencies": {
    "@fontsource/sora": "^5.3.0",
    "@remotion/bundler": "^4.0.500",
    "@remotion/renderer": "^4.0.500",
    "@remotion/transitions": "^4.0.500",
    "esbuild": "^0.25.12",
    "framer-motion": "^11.3.0",
    "hyperframes": "^0.8.147",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "remotion": "^4.0.500",
    "ws": "^8.22.0",
    "zustand": "^4.5.4"
  },
  "devDependencies": {
    "@types/node": "^20.14.0",
    "@types/react": "^18.3.3",
    "@types/react-dom": "^18.3.0",
    "@types/ws": "^8.18.2",
    "@vitejs/plugin-react": "^4.3.1",
    "autoprefixer": "^10.4.19",
    "electron": "^43.7.9",
    "electron-builder": "^26.15.3",
    "electron-vite": "^2.3.0",
    "pngjs": "^7.0.0",
    "postcss": "^8.4.39",
    "tailwindcss": "^3.4.6",
    "typescript": "^5.5.3",
    "vite": "^5.3.4"
  },
  "build": {
    "appId": "com.stravelakis.videoforge",
    "productName": "Video Forge",
    "directories": {
      "output": "release",
      "buildResources": "build"
    },
    "asar": false,
    "files": [
      "out/**",
      "remotion/**",
      "src/**",
      "puppet/**",
      "brands/**",
      "brand.local.json",
      "music/**",
      "sfx/library/**",
      "presets/**",
      "tools/windows-ca-bundle.pem",
      "tsconfig.json",
      "package.json",
      "!**/*.map",
      "!release/**",
      "!piper-venv/**",
      "!stableaudio-venv/**",
      "!models/**",
      "!dramabox-audition/**",
      "!viseme*/**",
      "!voice-refs/**",
      "!jobs/**",
      "!docs/**",
      "!inspiration looks/**",
      "!brands/*/intros/**",
      "!brands/*/outros/**",
      "!brands/*/banners/**",
      "!brands/*/presets/**",
      "!scripts/**"
    ],
    "win": {
      "target": [
        "nsis",
        "portable"
      ],
      "icon": "build/icon.png"
    },
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "Video Forge",
      "deleteAppDataOnUninstall": false,
      "include": "build/installer.nsh"
    },
    "portable": {
      "artifactName": "video-forge-portable.exe"
    }
  }
}
